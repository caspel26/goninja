			},
		},
	}

	listParams := []openapi.Parameter{
	{{- range .Model.FilterFields}}
		{Name: "{{.JSONName}}", In: "query", Schema: openapi.Schema{Type: "{{.OpenAPIType}}"{{if .OpenAPIFormat}}, Format: "{{.OpenAPIFormat}}"{{end}}}},
	{{- if .IsNumeric}}
		{Name: "{{.JSONName}}_min", In: "query", Schema: openapi.Schema{Type: "{{.OpenAPIType}}"{{if .OpenAPIFormat}}, Format: "{{.OpenAPIFormat}}"{{end}}}},
		{Name: "{{.JSONName}}_max", In: "query", Schema: openapi.Schema{Type: "{{.OpenAPIType}}"{{if .OpenAPIFormat}}, Format: "{{.OpenAPIFormat}}"{{end}}}},
	{{- end}}
	{{- end}}
	}

	return goninja.BuildResourceOpenAPI(&r.BaseResource, r.resourceConfig(), goninja.ResourceDoc{
		Name:      "{{.Model.Name}}",
		NameLower: "{{.Model.NameLower}}",
		IDSchema: openapi.Schema{
			Type: "{{if eq .Model.IDGoType "int64"}}integer{{else}}string{{end}}"{{if eq .Model.IDGoType "int64"}}, Format: "int64"{{end}},
		},
		Schemas:    schemas,
		ListParams: listParams,
	})
}

// resourceConfig resolves r's ResourceConfig via r.Self(), the same
// dispatch hooks.go and ops() use: a wrapper implementing
// goninja.Configurer customizes it, otherwise every
// generated default applies.
func (r *{{.Model.Name}}Resource) resourceConfig() goninja.ResourceConfig {
	if c, ok := r.Self().(goninja.Configurer); ok {
		return c.Config()
	}
	return goninja.ResourceConfig{}
}

// Register mounts list/retrieve/create/update/delete routes for
// {{.Model.Name}} under /{{.Model.NameLower}}s on mux (any goninja.Router —
// *http.ServeMux, or an adapter for gin/echo/chi), or under r's
// ResourceConfig.Path/Routes override (see resourceConfig above) if one is
// set. Every handler is wrapped through r.Protect, which applies this
// resource's Config (global default auth + generic middleware, set via
// API.MountWithConfig — see config.go) combined with cfg's own per-route
// Auth override (ResourceConfig.Auth, keyed by Route); a resource mounted
// via plain API.Mount has a zero Config, so Protect is a no-op there.
// Every Action declared via SetActions is mounted last, on the same mux,
// at <path>[/{id}][/UrlPath] depending on its Detail/UrlPath, wrapped
// through r.ProtectAction instead (consults Action.Auth first). Before
// mounting anything, r.CheckStrictAuth panics if Config.StrictAuth is set
// and any route below has no explicit auth decision — a no-op otherwise.
func (r *{{.Model.Name}}Resource) Register(mux goninja.Router) {
	cfg := r.resourceConfig()
	path := cfg.PathOr("/{{.Model.NameLower}}s")
	crudRoutes := [...]struct {
		route   goninja.Route
		method  string
		path    string
		handler http.HandlerFunc
	}{
		{goninja.RouteList, "GET", path, r.listHandler},
		{goninja.RouteCreate, "POST", path, r.createHandler},
		{goninja.RouteRetrieve, "GET", path + "/{id}", r.retrieveHandler},
		{goninja.RouteUpdate, "PUT", path + "/{id}", r.updateHandler},
		{goninja.RouteDelete, "DELETE", path + "/{id}", r.deleteHandler},
	}
	var enabledRoutes []goninja.Route
	for _, rt := range crudRoutes {
		if cfg.RouteEnabled(rt.route) {
			enabledRoutes = append(enabledRoutes, rt.route)
		}
	}
	r.CheckStrictAuth(enabledRoutes, r.Actions(), cfg)
	for _, rt := range crudRoutes {
		if cfg.RouteEnabled(rt.route) {
			mux.HandleFunc(rt.method+" "+rt.path, r.Protect(rt.route, cfg, rt.handler))
		}
	}
	for _, a := range r.Actions() {
		p := path
		if a.Detail {
			p += "/{id}"
		}
		if a.UrlPath != "" {
			p += "/" + a.UrlPath
		}
		mux.HandleFunc(a.Method+" "+p, r.ProtectAction(a, cfg))
	}
}
